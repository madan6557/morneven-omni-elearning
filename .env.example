# Copy to apps/api/.env and apps/web/.env
# BE — SQLite dev (no docker), prod ganti ke Postgres:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elearning?schema=public"
#   and in packages/db/prisma/schema.prisma change provider to postgresql + regenerate
DATABASE_URL="file:./packages/db/prisma/dev.db"
JWT_SECRET="change-me-super-secret-min-32chars"
API_KEY="dev-api-key-change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
# FE
VITE_API_URL="http://localhost:4000"
